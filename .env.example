# Mapbox - https://console.mapbox.com (required)
# Client-side by design: Mapbox tokens are meant to be public and are scoped/
# domain-restricted from the Mapbox account dashboard, unlike the keys below.
VITE_MAPBOX_TOKEN=

# NewsAPI - https://newsapi.org (free: 100 req/day)
# Client-side: NewsAPI's free tier already blocks non-localhost browser origins,
# so there's no production exposure to hide.
VITE_NEWSAPI_KEY=

# AISStream.io - https://aisstream.io (free WebSocket vessel tracking)
# Client-side: this key only grants read access to public AIS broadcast data,
# a raw WebSocket connection can't be routed through the serverless functions
# below without extra infra, and there's no billing risk on the free tier.
VITE_AISSTREAM_KEY=

# ── Server-only keys ──────────────────────────────────────────────────────────
# No VITE_ prefix: Vite never bundles these into the client, and they're only
# read by the api/*.ts serverless functions (Vercel). Set these in Vercel's
# project settings (Settings -> Environment Variables) for production, and in
# this .env file for local `vercel dev`.

# The Guardian - https://open-platform.theguardian.com/access (free)
GUARDIAN_KEY=

# New York Times - https://developer.nytimes.com (free)
NYT_KEY=

# Finnhub Stock API - https://finnhub.io (free: 60 req/min)
FINNHUB_KEY=

# ACLED - https://acleddata.com (OAuth, free for non-commercial)
ACLED_EMAIL=
ACLED_PASSWORD=

# OpenSky Network - https://opensky-network.org (OAuth2 client credentials)
OPENSKY_USER=
OPENSKY_PASS=

# OpenRouter AI - https://openrouter.ai (free + paid models, powers the AI Analyst panel)
OPENROUTER_KEY=
