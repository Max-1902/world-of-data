{
  "name": "macroeconomic-forecasting-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p desktop/tsconfig.json",
    "preview": "vite preview",
    "desktop": "node scripts/build-desktop.mjs && node scripts/start-desktop.mjs",
    "desktop:dist": "node scripts/build-desktop.mjs && electron-builder --publish never",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:watch": "vitest",
    "bench:analyst": "vitest run --config vitest.bench.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "h3-js": "^4.5.0",
    "lucide-react": "^0.460.0",
    "mapbox-gl": "^3.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
